rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ¿el que hace la petición es administrador y está activo?
    function esAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == 'admin'
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.estado == 'activo';
    }

    // Usuarios: cualquiera con sesión puede leerlos.
    //  - creas TU propio perfil (queda 'pendiente' hasta que un admin lo apruebe;
    //    el primer usuario del sistema puede quedar 'activo'/'admin')
    //  - un admin puede aprobar cuentas y designar administradores
    match /usuarios/{uid} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == uid;
      allow update, delete: if esAdmin()
                    || (request.auth != null && request.auth.uid == uid);
    }

    // Ventas registradas por los asesores (garantía, seguro, fpuntos, no mix).
    match /ventas/{id} {
      allow read:   if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.registradoPor == request.auth.uid;
      allow update, delete: if esAdmin()
                    || (request.auth != null && resource.data.registradoPor == request.auth.uid);
    }

    // Avances importados desde Looker: los sube un administrador.
    match /avances/{id} {
      allow read:  if request.auth != null;
      allow write: if esAdmin();
    }

    // Imágenes de boletas (dataURL) guardadas aparte para no inflar 'ventas'.
    match /boletas/{id} {
      allow read:   if request.auth != null;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow update, delete: if esAdmin()
                    || (request.auth != null && resource.data.uid == request.auth.uid);
    }

    // Configuración compartida (mes comercial, metas, colores, claves): solo admin escribe.
    match /config/{doc} {
      allow read:  if request.auth != null;
      allow write: if esAdmin();
    }
  }
}
